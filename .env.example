# Telegram (copy from ../telegram-auth/.env)
TG_BOT_TOKEN=
TG_TARGET=

# Brokers to track. Format: <a>:<b>:<display_name>,<a>:<b>:<display_name>...
# Each broker generates its own history file and its own Telegram message.
BROKERS=9800:9800:元大證券,9200:9268:凱基-台北

# Daily report settings
DAILY_TOP_N=5
CONSECUTIVE_DAYS=3,5
CONSECUTIVE_TOP_N=10
